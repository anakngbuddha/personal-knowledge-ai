ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pka
RLS_REQUIRED=false
CORS_ORIGINS=http://localhost:5173
AUTH_MODE=jwt
# Leave empty for local development: the app then uses a random per-process key
# (sessions end on restart). Anywhere else, generate one and keep it secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Published placeholders and low-entropy values are refused at startup.
JWT_SECRET_KEY=
ALLOW_LEGACY_TOKEN_ENDPOINT=false
DEFAULT_ORG_SLUG=default
DEFAULT_ORG_NAME=Default Organization
# Self-service signup creates a new organization for anyone. Turn it off once your
# organization exists and invite people from the admin page.
SIGNUP_ENABLED=true
# Auth endpoint throttling (per client IP, and failed logins per account).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_PER_MINUTE=10
AUTH_SIGNUP_IP_PER_HOUR=5
AUTH_LOGIN_FAILURES_PER_ACCOUNT=8
# Reverse proxies in front of the app that append X-Forwarded-For (0 = none).
TRUSTED_PROXY_HOPS=0
STORAGE_BACKEND=local
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake
GEMINI_API_KEY=
TAVILY_API_KEY=
# Used when Gemini generation fails, and when EMBEDDING_PROVIDER=openrouter.
# Nemotron embeddings are 2048-d and refuse to run against the default 768-d index.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBEDDING_DIMENSIONS=2048
GEMINI_RPM=10
OCR_PROVIDER=none
AUTO_APPROVE_UPLOADS=false
# The product list starts empty. Turn this on only for a demo: everything the sample
# catalog creates is marked as sample material and is kept out of answers.
DEMO_SEED_CATALOG=false
CATALOG_IMPORT_MAX_ROWS=2000
GRAPH_EXTRACTION_ENABLED=true
GRAPH_AUTO_ACCEPT_CONFIDENCE=0.85
GRAPH_EXPANSION_ENABLED=true
GRAPH_EXPANSION_HOPS=2
MCP_ENABLED=false
WORKER_ENABLED=true
FRESHNESS_WORKER_ENABLED=false
WORKFLOW_WORKER_ENABLED=true
MALWARE_SCANNER=heuristic
URL_FETCH_ENABLED=true
URL_FETCH_ALLOW_PRIVATE_IPS=false

# Generate with Fernet.generate_key(); no password-derived keys are accepted.
# CREDENTIALS_KEY_ID=v1
# CREDENTIALS_PREVIOUS_KEYS={"v0":"<previous-valid-Fernet-key>"}
# SAML_IDP_CERTIFICATE=<trusted-IdP-X509-certificate>
# SAML_IDP_SSO_URL=https://idp.example/sso
