
# ---------------------------------------------------------------------------
# Phase 1-2 additions
# ---------------------------------------------------------------------------

# Tenancy. Phase 0 (real authN, RLS, audit log) is NOT built.
#   owner_dev   - every request is the single collateral owner (full read access)
#   dev_headers - read X-Org-Id / X-User-Id / X-User-Role to exercise authorization
AUTH_MODE=owner_dev
DEFAULT_ORG_SLUG=default

# Ingestion safety limits
PARSE_TIMEOUT_SECONDS=120
MAX_ARCHIVE_ENTRIES=2000
MAX_UNCOMPRESSED_MB=400
MAX_COMPRESSION_RATIO=120
MAX_PDF_PAGES=3000
MAX_EXTRACTED_CHARS=20000000

# Malware scanning: none | heuristic | clamav. `clamav` fails closed if unreachable.
MALWARE_SCANNER=heuristic
CLAMAV_HOST=
CLAMAV_PORT=3310

# OCR for scanned PDFs: none | tesseract (needs the tesseract binary + pytesseract)
OCR_PROVIDER=none
OCR_LANGUAGE=eng
OCR_MAX_PAGES=50

# URL ingestion through the SSRF-safe fetcher
URL_FETCH_ENABLED=true
URL_FETCH_TIMEOUT_SECONDS=20
URL_FETCH_MAX_REDIRECTS=3
# Tests only. Never enable in production.
URL_FETCH_ALLOW_PRIVATE_IPS=false

# Ingestion worker. Set false on the web process if running scripts/worker.py.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_BASE_SECONDS=15
JOB_BACKOFF_MAX_SECONDS=900

# Retrieval
CANDIDATE_K=50
FTS_CONFIG=english
