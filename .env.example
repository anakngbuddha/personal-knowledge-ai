ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pka
CORS_ORIGINS=http://localhost:5173
AUTH_MODE=jwt
JWT_SECRET_KEY=replace-with-a-random-32-plus-character-secret
ALLOW_LEGACY_TOKEN_ENDPOINT=false
DEFAULT_ORG_SLUG=default
DEFAULT_ORG_NAME=Default Organization
STORAGE_BACKEND=local
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake
GEMINI_API_KEY=
# Used when Gemini generation fails, and when EMBEDDING_PROVIDER=openrouter.
# Nemotron embeddings are 2048-d and refuse to run against the default 768-d index.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBEDDING_DIMENSIONS=2048
GEMINI_RPM=10
OCR_PROVIDER=none
AUTO_APPROVE_UPLOADS=true
# The product list starts empty. Turn this on only for a demo: everything the sample
# catalog creates is marked as sample material and is kept out of answers.
DEMO_SEED_CATALOG=false
CATALOG_IMPORT_MAX_ROWS=2000
GRAPH_EXTRACTION_ENABLED=true
GRAPH_AUTO_ACCEPT_CONFIDENCE=0.85
GRAPH_EXPANSION_ENABLED=true
GRAPH_EXPANSION_HOPS=2
MCP_ENABLED=false
WORKER_ENABLED=true
FRESHNESS_WORKER_ENABLED=false
WORKFLOW_WORKER_ENABLED=true
MALWARE_SCANNER=heuristic
URL_FETCH_ENABLED=true
URL_FETCH_ALLOW_PRIVATE_IPS=false
