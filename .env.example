# ---------------------------------------------------------------------------
# Backend configuration. Copy to backend/.env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Database (Aiven PostgreSQL, must have the `vector` extension available)
# Use the psycopg v3 driver prefix: postgresql+psycopg://
DATABASE_URL=

# Object storage (Cloudflare R2). Use STORAGE_BACKEND=local for offline dev only.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override; defaults to https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Providers. EMBEDDING_PROVIDER=fake gives deterministic offline vectors for testing.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Retrieval / ingestion knobs
TOP_K=8
RRF_K=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=16
MAX_UPLOAD_MB=25
